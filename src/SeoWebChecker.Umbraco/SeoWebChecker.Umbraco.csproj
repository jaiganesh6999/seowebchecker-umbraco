<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <PackageId>SeoWebChecker.Umbraco</PackageId>
    <Version>1.0.0</Version>
    <Title>SEOWebChecker SEO Audit for Umbraco</Title>
    <Authors>SEOWebChecker</Authors>
    <Company>SEOWebChecker</Company>
    <Description>Comprehensive on-page search engine optimization (SEO) diagnostics, meta tag analyzer, and health checks for Umbraco websites by SEOWebChecker (https://seowebchecker.com/).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://seowebchecker.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jaiganesh6999/seowebchecker-umbraco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;seo;seo-audit;seowebchecker;meta-tags;technical-seo;healthcheck</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="[13.0.0, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\umbraco-marketplace.json" Pack="true" PackagePath="\" />
    <Content Include="App_Plugins\SeoWebChecker\**\*" PackagePath="staticwebassets\App_Plugins\SeoWebChecker" />
    <Content Include="App_Plugins\SeoWebChecker\**\*" PackagePath="contentFiles\any\any\App_Plugins\SeoWebChecker" />
    <Content Include="build\**\*" PackagePath="build" />
  </ItemGroup>

</Project>
